[Unit]
Description=EXIMOBILE Website (Next.js standalone)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/eximobile-website
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/opt/eximobile-website/.env
StandardOutput=append:/var/log/eximobile-website/app.log
StandardError=append:/var/log/eximobile-website/error.log

[Install]
WantedBy=multi-user.target
